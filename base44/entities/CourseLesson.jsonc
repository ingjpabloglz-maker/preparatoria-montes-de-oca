{
  "name": "CourseLesson",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "description": "ID del m\u00f3dulo al que pertenece"
    },
    "subject_id": {
      "type": "string",
      "description": "ID de la materia (para filtros r\u00e1pidos)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo de la lecci\u00f3n"
    },
    "explanation": {
      "type": "object",
      "description": "Explicaci\u00f3n estructurada de la lecci\u00f3n",
      "properties": {
        "intro": {
          "type": "string"
        },
        "key_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "solution": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "visual_blocks": {
          "type": "array",
          "description": "Bloques visuales pedag\u00f3gicos (tabla, comparaci\u00f3n, pasos, ecuaci\u00f3n, flujo, l\u00ednea de tiempo, mapa)",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "table",
                  "comparison",
                  "steps",
                  "equation",
                  "flow",
                  "timeline",
                  "map"
                ]
              },
              "title": {
                "type": "string"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "equations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "year": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    }
                  }
                }
              },
              "left_title": {
                "type": "string"
              },
              "right_title": {
                "type": "string"
              },
              "left_items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "right_items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "connects_to": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "content": {
                "type": "string"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "image_search_terms": {
          "type": "array",
          "description": "T\u00e9rminos de b\u00fasqueda para im\u00e1genes educativas reales (2-3 strings cortos y espec\u00edficos)",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "order": {
      "type": "number",
      "description": "Orden de la lecci\u00f3n dentro del m\u00f3dulo"
    },
    "is_mini_eval": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, es la mini evaluaci\u00f3n final del m\u00f3dulo"
    },
    "generation_completed": {
      "type": "boolean",
      "default": false,
      "description": "Si la generaci\u00f3n de actividades est\u00e1 completa"
    }
  },
  "required": [
    "module_id",
    "subject_id",
    "title",
    "order"
  ]
}