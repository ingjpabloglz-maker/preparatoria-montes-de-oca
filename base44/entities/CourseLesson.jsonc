{
  "name": "CourseLesson",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "description": "ID del m\u00f3dulo al que pertenece"
    },
    "subject_id": {
      "type": "string",
      "description": "ID de la materia (para filtros r\u00e1pidos)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo de la lecci\u00f3n"
    },
    "explanation": {
      "type": "object",
      "description": "Explicaci\u00f3n estructurada de la lecci\u00f3n",
      "properties": {
        "intro": {
          "type": "string"
        },
        "key_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "solution": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "order": {
      "type": "number",
      "description": "Orden de la lecci\u00f3n dentro del m\u00f3dulo"
    },
    "is_mini_eval": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, es la mini evaluaci\u00f3n final del m\u00f3dulo"
    },
    "generation_completed": {
      "type": "boolean",
      "default": false,
      "description": "Si la generaci\u00f3n de actividades est\u00e1 completa"
    }
  },
  "required": [
    "module_id",
    "subject_id",
    "title",
    "order"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "user"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}