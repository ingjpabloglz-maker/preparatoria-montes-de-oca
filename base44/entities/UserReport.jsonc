{
  "name": "UserReport",
  "type": "object",
  "properties": {
    "reported_user_email": {
      "type": "string",
      "description": "Email del usuario reportado"
    },
    "reported_user_name": {
      "type": "string",
      "description": "Nombre del usuario reportado"
    },
    "reported_by": {
      "type": "string",
      "description": "Email del reportante"
    },
    "reported_by_role": {
      "type": "string",
      "description": "Rol del reportante"
    },
    "reason": {
      "type": "string",
      "description": "Raz\u00f3n del reporte"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n detallada"
    },
    "thread_id": {
      "type": "string",
      "description": "ID del hilo donde ocurri\u00f3"
    },
    "comment_id": {
      "type": "string",
      "description": "ID del comentario relacionado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email del admin que revis\u00f3"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "reported_user_email",
    "reported_by",
    "reason"
  ]
}