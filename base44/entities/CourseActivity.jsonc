{
  "name": "CourseActivity",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID de la lecci\u00f3n a la que pertenece"
    },
    "type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "true_false",
        "fill_blank"
      ],
      "description": "Tipo de actividad"
    },
    "question": {
      "type": "string",
      "description": "Enunciado de la pregunta"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Opciones de respuesta (para multiple_choice)"
    },
    "correct_answer": {
      "type": "string",
      "description": "Respuesta correcta"
    },
    "explanation": {
      "type": "string",
      "description": "Explicaci\u00f3n de la respuesta correcta"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium"
    },
    "order": {
      "type": "number",
      "description": "Orden dentro de la lecci\u00f3n"
    }
  },
  "required": [
    "lesson_id",
    "type",
    "question",
    "order"
  ]
}