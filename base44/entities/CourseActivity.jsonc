{
  "name": "CourseActivity",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "ID de la lecci\u00f3n a la que pertenece"
    },
    "type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "true_false",
        "fill_blank",
        "solve",
        "match",
        "order_steps",
        "multiple_select",
        "drag_drop",
        "step_by_step"
      ],
      "description": "Tipo de actividad"
    },
    "question": {
      "type": "string",
      "description": "Enunciado de la pregunta"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Opciones de respuesta"
    },
    "correct_answer": {
      "type": "string",
      "description": "Respuesta correcta principal (string). Usado por: multiple_choice, true_false, fill_blank, solve, drag_drop, step_by_step."
    },
    "correct_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Respuestas correctas como array nativo. Usado por: multiple_select, order_steps."
    },
    "accepted_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Respuestas alternativas v\u00e1lidas (para solve/fill_blank)"
    },
    "explanation": {
      "type": "string",
      "description": "Explicaci\u00f3n b\u00e1sica de la respuesta correcta"
    },
    "explanation_levels": {
      "type": "object",
      "description": "Explicaciones en m\u00faltiples niveles de profundidad",
      "properties": {
        "basic": {
          "type": "string",
          "description": "Explicaci\u00f3n corta y directa"
        },
        "detailed": {
          "type": "string",
          "description": "Explicaci\u00f3n ampliada con razonamiento"
        },
        "example": {
          "type": "string",
          "description": "Ejemplo concreto paso a paso"
        }
      }
    },
    "incorrect_feedback": {
      "type": "object",
      "description": "Feedback espec\u00edfico por tipo de error o por opci\u00f3n incorrecta seleccionada."
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pistas progresivas: hint[0] para intento 2, hint[1] para intento 3"
    },
    "max_attempts": {
      "type": "number",
      "default": 3,
      "description": "N\u00famero m\u00e1ximo de intentos antes de revelar la respuesta"
    },
    "points": {
      "type": "number",
      "default": 10,
      "description": "Puntos base que otorga esta actividad"
    },
    "time_limit_seconds": {
      "type": "number",
      "description": "Tiempo l\u00edmite en segundos (opcional)."
    },
    "order": {
      "type": "number",
      "description": "Orden dentro de la lecci\u00f3n"
    },
    "grading_type": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "hybrid"
      ],
      "default": "auto",
      "description": "auto=comparaci\u00f3n directa, manual=requiere docente, hybrid=auto+revisi\u00f3n"
    },
    "tolerance": {
      "type": "number",
      "default": 0,
      "description": "Margen de error permitido para respuestas num\u00e9ricas"
    },
    "requires_manual_review": {
      "type": "boolean",
      "default": false,
      "description": "Si siempre debe ser revisada manualmente"
    },
    "visual_url": {
      "type": "string",
      "description": "URL de imagen educativa de apoyo"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium",
      "description": "Nivel de dificultad de la actividad"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "description": "Para type=step_by_step: pasos ordenados a completar"
    },
    "drag_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Para type=drag_drop: \u00edtems a arrastrar (mezclados)"
    },
    "drop_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Para type=drag_drop: etiquetas de los destinos"
    }
  },
  "required": [
    "lesson_id",
    "type",
    "question",
    "order"
  ]
}