{
  "name": "WeeklyGoalSession",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del alumno"
    },
    "week_cycle_id": {
      "type": "string",
      "description": "Identificador del ciclo semanal: YYYY-Www (ej: 2026-W23) basado en fecha de inicio"
    },
    "goal_number_in_cycle": {
      "type": "number",
      "description": "N\u00famero de meta dentro del ciclo (1, 2, 3...). Solo las primeras 2 son recompensadas.",
      "default": 1
    },
    "target": {
      "type": "number",
      "description": "N\u00famero de lecciones objetivo (m\u00ednimo 5)"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Lecciones completadas hacia esta meta"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "rewarded",
        "failed",
        "archived"
      ],
      "default": "active",
      "description": "State machine formal. active=en progreso; completed=alcanz\u00f3 target, pendiente de recompensa; rewarded=recompensa otorgada; failed=expir\u00f3 sin completar; archived=cerrada hist\u00f3ricamente"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Legacy: true si se alcanz\u00f3 el target. Usar status en lugar de este campo."
    },
    "reward_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Legacy: true si las recompensas ya fueron otorgadas. Usar status=rewarded en lugar de este campo."
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Legacy: true si la meta fue cerrada. Usar status=archived en lugar de este campo."
    },
    "reward_xp": {
      "type": "number",
      "default": 0,
      "description": "XP bonus otorgado al completar esta meta"
    },
    "reward_stars": {
      "type": "number",
      "default": 0,
      "description": "Estrellas bonus otorgadas al completar esta meta"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp UTC de creaci\u00f3n de la meta"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "started_at + 7 d\u00edas exactos en UTC (rolling window). Autoridad absoluta del backend."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp UTC cuando se complet\u00f3 la meta (progress >= target)"
    },
    "rewarded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp UTC cuando se otorg\u00f3 la recompensa"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp UTC cuando la meta fue marcada como fallida (expir\u00f3 sin completar)"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp UTC cuando la meta fue archivada definitivamente"
    }
  },
  "required": [
    "user_email",
    "target",
    "started_at",
    "expires_at",
    "status"
  ]
}