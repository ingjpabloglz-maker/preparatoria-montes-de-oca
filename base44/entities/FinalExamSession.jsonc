{
  "name": "FinalExamSession",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del alumno"
    },
    "subject_id": {
      "type": "string",
      "description": "ID de la materia"
    },
    "subject_name": {
      "type": "string",
      "description": "Nombre de la materia"
    },
    "exam_version": {
      "type": "string",
      "default": "2.0",
      "description": "Versi\u00f3n del sistema de examen"
    },
    "grading_version": {
      "type": "string",
      "default": "1.0",
      "description": "Versi\u00f3n del algoritmo de calificaci\u00f3n para trazabilidad futura"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "submitted_late",
        "expired",
        "auto_graded"
      ],
      "default": "in_progress"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueado tras submit, timeout o auto-grade"
    },
    "exam_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "exam_started_at + 1 hora (autoridad backend)"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "attempt_number": {
      "type": "number",
      "default": 1
    },
    "auto_graded": {
      "type": "boolean",
      "default": false,
      "description": "true si fue calificado autom\u00e1ticamente por timeout"
    },
    "recovery_count": {
      "type": "number",
      "default": 0,
      "description": "Veces que el alumno recuper\u00f3 la sesi\u00f3n (refresh/reconexi\u00f3n)"
    },
    "autosave_count": {
      "type": "number",
      "default": 0,
      "description": "Total de autosaves realizados"
    },
    "questions": {
      "type": "array",
      "description": "Copia inmutable de preguntas. correct_answer NUNCA se env\u00eda al frontend antes del submit.",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "activity_id": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "true_false",
              "fill_blank"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "correct_answer": {
            "type": "string",
            "description": "Solo en DB. JAM\u00c1S al frontend antes del submit."
          },
          "explanation": {
            "type": "string",
            "description": "Solo se env\u00eda al frontend despu\u00e9s del submit."
          },
          "user_answer": {
            "type": "string"
          },
          "is_correct": {
            "type": "boolean"
          },
          "score_points": {
            "type": "number"
          },
          "flagged": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "score": {
      "type": "number"
    },
    "passed": {
      "type": "boolean"
    },
    "correct_count": {
      "type": "number"
    },
    "incorrect_count": {
      "type": "number"
    },
    "ip_address": {
      "type": "string"
    },
    "device_info": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "subject_id",
    "exam_started_at",
    "expires_at",
    "questions",
    "attempt_number"
  ]
}